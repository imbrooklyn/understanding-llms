{
  "version": "mini-gpt-v1",
  "vocab_size": 291,
  "context_length": 64,
  "width": 16,
  "heads": 2,
  "ffn_width": 64,
  "layers": 1,
  "norm": "pre-layernorm",
  "epsilon": 0.00001,
  "activation": "relu",
  "position": "learned-absolute",
  "dropout": 0.0,
  "tied_embeddings": false,
  "dtype": "float64",
  "device": "cpu",
  "threads": 1,
  "init_seed": 1729,
  "batch_seed": 101,
  "sampling_seed": 31415,
  "init_std": 0.02,
  "batch_size": 8,
  "steps": 600,
  "eval_every": 50,
  "resume_step": 300,
  "optimizer": "Adam",
  "learning_rate": 0.01,
  "betas": [0.9, 0.999],
  "adam_epsilon": 1e-8,
  "weight_decay": 0.0,
  "selection": "first minimum validation loss among steps 0,50,...,600",
  "max_new_tokens": 24
}
