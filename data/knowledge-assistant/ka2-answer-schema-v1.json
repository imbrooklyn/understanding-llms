{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge assistant answer v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ka-answer-v1"
    },
    "status": {
      "enum": [
        "answered",
        "abstained",
        "refused",
        "error"
      ]
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount_yuan": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "version",
          "line_start",
          "line_end",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "answer",
    "amount_yuan",
    "citations",
    "reason_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "answered"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "minItems": 1
          },
          "reason_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "answer": {
            "type": "null"
          },
          "amount_yuan": {
            "type": "null"
          },
          "citations": {
            "maxItems": 0
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
