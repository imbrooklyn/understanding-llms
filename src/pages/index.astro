---
const destination = "/books/understanding-llms/en/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <title>Understanding Large Language Models from the Ground Up</title>
    <link
      rel="canonical"
      href="https://imbrooklyn.dev/books/understanding-llms/en/"
    />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>
      Continue to <a href={destination}
        >Understanding Large Language Models from the Ground Up</a
      >.
    </p>
  </body>
</html>
