---
const destination = "/books/understanding-llms/zh-hans/";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <title>理解大语言模型</title>
    <link
      rel="canonical"
      href="https://imbrooklyn.dev/books/understanding-llms/zh-hans/"
    />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>
      正在进入<a href={destination}>《理解大语言模型》中文版</a>。
    </p>
  </body>
</html>
