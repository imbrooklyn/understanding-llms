---
import DefaultPageTitle from "@astrojs/starlight/components/PageTitle.astro";
import { chapterLabel, plannedChapters } from "../config/book.mjs";

const { entry, locale } = Astro.locals.starlightRoute;
const id = entry.id.split("/").at(-1);
const chapter = plannedChapters.find((item) => item.id === id);
const language = locale === "zh-hans" ? "zh-hans" : "en";
---

{
  chapter ? (
    <h1 id="_top" class="book-chapter-title">
      <span class="book-chapter-label">{chapterLabel(chapter.id, language)}</span>{" "}
      <span>{chapter.title[language]}</span>
    </h1>
  ) : <DefaultPageTitle />
}

<style>
  .book-chapter-title {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
    letter-spacing: -0.015em;
  }

  .book-chapter-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.025em;
  }
</style>
