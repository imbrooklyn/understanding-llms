{
  "name": "understanding-llms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync --force && astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "ci:build": "pnpm validate:content && pnpm validate:language && pnpm validate:part-i && pnpm test && pnpm check && pnpm build && node scripts/check-draft-output.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "validate:part-i": "node scripts/validate-part-i.mjs",
    "validate:language": "node scripts/validate-language.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.42.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.10",
    "katex": "^0.18.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
